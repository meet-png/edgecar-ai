CM_ "EdgeCar reference CAN FD database. Not an OEM database: the BMW i3's own DBC is proprietary, so the i3's real
signals are carried in these two 64-byte CAN FD frames to exercise the CAN FD ingestion path.";
CM_ SG_ 928 ThermalWarning "Battery management thermal warning level";
BA_DEF_ BO_  "VFrameFormat" ENUM  "StandardCAN","ExtendedCAN","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","StandardCAN_FD","ExtendedCAN_FD";
BA_DEF_DEF_  "VFrameFormat" "StandardCAN";
BA_ "VFrameFormat" BO_ 928 14;
BA_ "VFrameFormat" BO_ 432 14;
VAL_ 928 ThermalWarning 0 "None" 1 "RiseRate" 2 "HighTemp" 3 "OverTemp" ;
